REDIS_URL=redis://127.0.0.1:6379/0
RPC_URL=https://replace-with-seismic-rpc
INTERNAL_FUNDING_CHAIN_ID=replace-with-chain-id
INTERNAL_FUNDING_TOKEN=replace-with-at-least-32-random-characters
INTERNAL_FUNDING_PRIVATE_KEY=0xreplace-with-dedicated-machine-key
INTERNAL_FUNDING_ADDRESS=0xreplace-with-address-derived-from-machine-key
FAUCET_ADDRESS=0xreplace-with-existing-susdc-faucet
INTERNAL_FUNDING_MAX_SUSDC_AMOUNT=250000000
INTERNAL_FUNDING_GAS_SUSDC_AMOUNT=100000
INTERNAL_FUNDING_GLOBAL_SUSDC_BUDGET=1000000000
INTERNAL_FUNDING_GLOBAL_GAS_SUSDC_BUDGET=10000000

# Optional standard ERC20 USDC path. Existing deployments boot when this block is absent.
INTERNAL_FUNDING_ERC20_USDC_ENABLED=false
INTERNAL_FUNDING_ERC20_USDC_PRIVATE_KEY=0xreplace-with-dedicated-erc20-machine-key
INTERNAL_FUNDING_ERC20_USDC_ADDRESS=0xreplace-with-address-derived-from-erc20-machine-key
ERC20_USDC_RESERVE_ADDRESS=0xreplace-with-distinct-offline-recovery-address
ERC20_USDC_TOKEN_ADDRESS=0xreplace-after-deployment
ERC20_USDC_FAUCET_ADDRESS=0xreplace-after-deployment
INTERNAL_FUNDING_MAX_ERC20_USDC_AMOUNT=250000000
INTERNAL_FUNDING_GLOBAL_ERC20_USDC_BUDGET=1000000000
INTERNAL_FUNDING_ERC20_USDC_RATE_LIMIT=10
INTERNAL_FUNDING_ERC20_USDC_RATE_WINDOW_SECONDS=3600

# Optional Base token catalog, parsed only when INTERNAL_FUNDING_BASE_ENABLED=true.
# Catalog registration does not enable additional transfer endpoints or mint execution.
# Amounts are decimal base-unit strings; mint arguments below are whole tokens.
# Permissionless mint strategies require contract review, not selector detection.
# INTERNAL_FUNDING_BASE_ADDITIONAL_ERC20_TOKENS='[{"contract_address":"0x1111111111111111111111111111111111111111","decimals":6,"max_transfer":"250000000","global_budget":"1000000000","reserve_floor":"0","funding":{"kind":"caller_mint_whole_tokens","max_tokens_per_call":100,"max_calls":4}}]'
# For manually supplied inventory, use funding: {"kind":"manual_inventory"}.
